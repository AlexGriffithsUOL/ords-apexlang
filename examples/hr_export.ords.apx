restSchema (
    enabled: true
    autoRestAuth: false
    urlMapping {
        type: basePath
        pattern: hr
    }
)

restModule hr.v1 (
    basePath: /hr/v1/
    itemsPerPage: 25
    status: published
    comments: HR employee API
    originsAllowed: https://apex.example.com

    template "employees/" (
        priority: 0
        etag {
            type: hash
        }

        handler GET (
            itemsPerPage: 25
            source {
                type: collection
                sqlQuery:
                    ```sql
                    select employee_id, first_name, last_name, email
                      from employees
                     where department_id = nvl(:dept, department_id)
                     order by last_name
                    ```
            }

            parameter dept (
                bindVariable: dept
                source: uri
                type: int
                accessMethod: in
            )

        )

        handler POST (
            itemsPerPage: 0
            mimesAllowed: application/json
            comments: Create an employee. Returns the new id in the Location header.
            source {
                type: plsql
                plsqlCode:
                    ```plsql
                    declare
                      l_id employees.employee_id%type;
                    begin
                      insert into employees (first_name, last_name, email, hire_date, job_id)
                      values (:first_name, :last_name, :email, sysdate, 'IT_PROG')
                      returning employee_id into l_id;

                      :status   := 201;
                      :location := l_id;
                    end;
                    ```
            }

            parameter X-ORDS-STATUS-CODE (
                bindVariable: status
                source: header
                type: int
                accessMethod: out
            )

            parameter Location (
                bindVariable: location
                source: header
                type: string
                accessMethod: out
            )

        )

    )

    template "employees/:id" (
        priority: 0
        etag {
            type: query
            query:
                ```sql
                select ora_hash(last_name || email) from employees where employee_id = :id
                ```
        }

        handler GET (
            itemsPerPage: 0
            source {
                type: item
                sqlQuery:
                    ```sql
                    select * from employees where employee_id = :id
                    ```
            }
        )

        handler DELETE (
            itemsPerPage: 0
            source {
                type: plsql
                plsqlCode:
                    ```plsql
                    begin
                      delete from employees where employee_id = :id;
                    end;
                    ```
            }
        )

    )

    template "departments/report.csv" (
        priority: 0
        etag {
            type: none
        }

        handler GET (
            itemsPerPage: 0
            source {
                type: csvQuery
                sqlQuery:
                    ```sql
                    select d.department_name, count(*) headcount
                      from departments d join employees e on e.department_id = d.department_id
                     group by d.department_name
                    ```
            }
        )

    )

)

